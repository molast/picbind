{
  "name": "@picbind/shared",
  "version": "0.1.0",
  "description": "Shared PicBind types, utilities, and Motion Intent Protocol runtime.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "check": "tsc --noEmit",
    "test:image-processing": "node --import tsx --test src/image-processing/contract.test.ts",
    "build:sdk": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build:preview": "vite build --outDir preview-dist",
    "build": "pnpm run build:sdk && pnpm run build:preview"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "tsx": "4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
