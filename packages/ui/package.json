{
  "name": "@picbind/ui",
  "version": "2.2.0",
  "description": "PicBind UI, image workspace, and realtime collaboration package.",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/room.css",
    "./source": "./src/index.ts",
    "./source.css": "./src/embed.css",
    "./source/config": "./src/config.ts",
    "./source/locales": "./src/locales/index.ts",
    "./source/create-room-button": "./src/components/share/create-room-button.tsx",
    "./source/worker-version": "./src/worker-version.ts",
    "./source/worker-version-warning": "./src/components/share/worker-version-warning.tsx",
    "./source/types": "./src/public-types.ts",
    "./source/image-storage": "./src/database/image-storage.ts",
    "./source/image-processing-web-runtime": "./src/image-processing/web-runtime.ts",
    "./source/download": "./src/download/index.ts"
  },
  "scripts": {
    "sync:worker-version": "node scripts/sync-worker-version.mjs",
    "dev": "node scripts/sync-worker-version.mjs && vite --host 127.0.0.1 --port 4174",
    "check": "node scripts/sync-worker-version.mjs && tsc --noEmit",
    "test:storage": "node --import tsx --test src/database/repositories/web-image-storage-repository.test.ts",
    "test:workspace": "node --import tsx --test src/workspace/*.test.ts",
    "build:sdk": "node scripts/sync-worker-version.mjs && vite build --mode library && tsc -p tsconfig.build.json",
    "build:preview": "node scripts/sync-worker-version.mjs && vite build --outDir preview-dist",
    "build": "pnpm run build:sdk && pnpm run build:preview"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@picbind/shared": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "@picbind/image-codecs": "workspace:*",
    "@picbind/image-wasm": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "dexie": "^4.4.4",
    "konva": "^9.3.22",
    "pixi.js": "^8.19.0",
    "qrcode": "^1.5.4",
    "react-icons": "^5.5.0",
    "react-zoom-pan-pinch": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "fake-indexeddb": "6.2.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
