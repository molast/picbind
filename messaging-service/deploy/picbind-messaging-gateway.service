[Unit]
Description=PicBind Messaging Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=picbind
Group=picbind
WorkingDirectory=/opt/picbind/messaging-service
Environment=NODE_ENV=production
Environment=PICBIND_MESSAGING_HOST=127.0.0.1
Environment=PICBIND_MESSAGING_PORT=4390
Environment=PICBIND_MESSAGING_DATA_DIR=/var/lib/picbind-messaging
ExecStart=/usr/bin/node gateway-dist/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/picbind-messaging

[Install]
WantedBy=multi-user.target
