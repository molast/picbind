{
  "name": "picbind",
  "version": "1.0.8",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "sync:worker-version": "node ../../packages/ui/scripts/sync-worker-version.mjs",
    "predev": "pnpm --dir ../../packages/shared build:sdk",
    "dev": "node ../../packages/ui/scripts/sync-worker-version.mjs && next dev -p 3000",
    "prebuild": "pnpm --dir ../../packages/shared build:sdk",
    "build": "node ../../packages/ui/scripts/sync-worker-version.mjs && next build",
    "start": "next start",
    "clean": "node -e \"for(const path of ['.next','out'])require('fs').rmSync(path,{recursive:true,force:true})\"",
    "dev:fresh": "npm run clean && npm run dev",
    "build:fresh": "npm run clean && npm run build",
    "check": "tsc --noEmit",
    "lint": "next lint",
    "test:image-processing": "node --import tsx --test src/image-processing/adapters/desktop-image-processing-service.test.ts src/image-processing/adapters/desktop-image-processing-selector.test.ts",
    "test:realtime": "node --import tsx --test src/realtime/adapters/*.test.ts src/components/workspace-route-mode.test.ts"
  },
  "dependencies": {
    "@picbind/image-codecs": "workspace:*",
    "@picbind/image-wasm": "workspace:*",
    "@picbind/perceptual-wasm": "workspace:*",
    "@picbind/shared": "workspace:*",
    "@picbind/ui": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@tanstack/react-query": "^5.51.4",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-websocket": "2.4.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "context-filter-polyfill": "^0.3.13",
    "google-fonts-complete": "^2.2.3",
    "konva": "^9.3.14",
    "lodash": "^4.17.21",
    "next": "^15.0.0",
    "pixi.js": "^8.19.0",
    "react": "^18",
    "react-compare-slider": "^3.1.0",
    "react-dom": "^18",
    "react-dropzone": "^15.0.0",
    "react-icons": "^5.2.1",
    "react-konva": "^18.2.10",
    "react-markdown": "^9.0.1",
    "react-mobile-cropper": "^0.10.0",
    "react-player": "^2.16.0",
    "react-zoom-pan-pinch": "^3.6.1",
    "sass": "^1.77.8",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "webpack": "^5.93.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/lodash": "^4.17.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "4.20.6",
    "typescript": "^5"
  }
}
