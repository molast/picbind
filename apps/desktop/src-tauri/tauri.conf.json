{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicBind",
  "version": "../../../package.json",
  "identifier": "com.picbind.desktop",
  "build": {
    "devUrl": "http://localhost:3000/tauri-dev.html",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "PicBind",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg-background.png",
        "windowPosition": {
          "x": 420,
          "y": 240
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
