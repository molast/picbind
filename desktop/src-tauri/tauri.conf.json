{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicBind",
  "version": "0.1.0",
  "identifier": "com.picbind.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://localhost:3000/tauri-dev.html",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "PicBind",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../web/public/images/favicon/android-chrome-512x512.png"
    ]
  }
}
