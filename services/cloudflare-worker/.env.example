# Used only by the Worker. Never expose these as VITE_* variables.
DEV_MODE=1
TURN_TOKEN_ID=replace-with-cloudflare-turn-token-id
TURN_API_TOKEN=replace-with-cloudflare-turn-api-token
FILE_TRANSFER_MODE=r2

QINIU_ACCESS_KEY=replace-with-qiniu-access-key
QINIU_SECRET_KEY=replace-with-qiniu-secret-key
QINIU_BUCKET=replace-with-qiniu-bucket
QINIU_UPLOAD_URL=https://upload.qiniup.com
QINIU_DOWNLOAD_URL=https://replace-with-qiniu-download-domain

R2_RTT_THRESHOLD_MS=200
R2_FILE_TTL_SECONDS=1800
R2_BUCKET_NAME=picbind-bucket
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
