# Metrics
NEXT_PUBLIC_METRICS_ENABLED=true
NEXT_PUBLIC_PAGE_VIEW_ENABLED=true

# Image comparison (build-time public feature flags; disabled by default)
NEXT_PUBLIC_IMAGE_COMPARE_ENABLED=false
NEXT_PUBLIC_IMAGE_COMPARE_SELECTION_ENABLED=false
NEXT_PUBLIC_COMPRESSION_QUALITY_METRICS_ENABLED=false
NEXT_PUBLIC_BUTTERAUGLI_ENABLED=false
# Maximum Butteraugli overall visual distance (lower is stricter).
NEXT_PUBLIC_BUTTERAUGLI_TARGET_SCORE=1.0

# PCE compression gain by target format (0.5-2.0, 1.0 keeps current behavior).
NEXT_PUBLIC_PCE_JPEG_K=1.0
NEXT_PUBLIC_PCE_PNG_K=1.0
NEXT_PUBLIC_PCE_WEBP_K=1.0
NEXT_PUBLIC_PCE_AVIF_K=1.0
# Optional: override API base URL for all endpoints.
# Development default: http://127.0.0.1:8787 (local Worker runtime)
# Production default: https://api.picbind.com
# Leave unset for local development. Set this in the production environment.
# NEXT_PUBLIC_API_BASE_URL=https://api.picbind.com

# Optional: endpoint-level overrides (leave empty to use NEXT_PUBLIC_API_BASE_URL)
# NEXT_PUBLIC_METRICS_API_PATH=https://api.picbind.com/api/metrics
# NEXT_PUBLIC_PAGE_VIEW_API_PATH=https://api.picbind.com/api/site/view
# NEXT_PUBLIC_SHARE_ROOM_API_PATH=https://api.picbind.com/api/realtime/room/create
# Optional standalone Room SDK entry. Leave unset to keep the current /share route.
# NEXT_PUBLIC_ROOM_APP_URL=https://room.picbind.com

# Admin
# Optional: endpoint-level override (leave empty to use NEXT_PUBLIC_API_BASE_URL)
# NEXT_PUBLIC_ADMIN_STATE_API_PATH=https://api.picbind.com/api/admin/state
NEXT_PUBLIC_ADMIN_KEY=replace-with-admin-key

# SEO
NEXT_PUBLIC_SITE_URL=https://picbind.com
BAIDU_PUSH_SITE=https://picbind.com
BAIDU_PUSH_TOKEN=replace-with-baidu-token
